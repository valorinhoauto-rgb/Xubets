rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required, email format)
    //   - isVip: bool (required)
    //   - role: string (required, 'admin' or 'user')
    //   - subscriptionStatus: string (optional, 'none', 'pending', 'active')
    //   - createdAt: timestamp
    //
    // Collection: pending_users
    // Document ID: {userId}
    // Fields: Same as UserProfile
    //
    // Collection: bets
    // Document ID: {betId}
    // Fields:
    //   - id: string
    //   - title: string
    //   - type: string (single, multi, bingo)
    //   - odds: number
    //   - analysis: string
    //   - isVip: bool
    //   - result: string (pending, win, loss, void)
    //   - createdAt: timestamp
    //
    // Collection: performance
    // Document ID: {perfId}
    // Fields:
    //   - date: string
    //   - units: number
    //   - type: string
    //
    // Collection: system
    // Document ID: access_control
    // Fields:
    //   - adminEmails: list<string>
    //   - vipEmails: list<string>
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "minecraftthedark@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isVip() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVip == true)
      );
    }

    // Validation Functions
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'isVip', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.isVip is bool &&
             data.role in ['admin', 'user'];
    }

    function isValidBet(data) {
      return data.keys().hasAll(['id', 'title', 'type', 'odds', 'analysis', 'isVip', 'matches']) &&
             data.id is string &&
             data.title is string &&
             data.type in ['single', 'multi', 'bingo'] &&
             data.odds is number &&
             data.isVip is bool &&
             data.matches is list;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.role == 'user' || isAdmin());
      allow update: if isAdmin() || (isOwner(userId) && 
                                     request.resource.data.role == resource.data.role && 
                                     request.resource.data.isVip == resource.data.isVip);
      allow delete: if isAdmin();

      match /taken_bets/{betId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /pending_users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin() || isOwner(userId);
    }

    match /bets/{betId} {
      allow read: if isAuthenticated() && (resource.data.isVip == false || isVip());
      allow create, update: if isAdmin() && isValidBet(request.resource.data);
      allow delete: if isAdmin();
    }

    match /performance/{perfId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
